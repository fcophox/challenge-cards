// Generates supabase/seed.sql from the TypeScript catalogue (single source of truth).
// Usage: npm run db:seed
import { CHALLENGES } from "../src/data/challenges.ts";
import { ACHIEVEMENTS } from "../src/lib/game/achievements.ts";
import { RARITIES } from "../src/lib/game/config.ts";

const q = (v: string) => `'${v.replaceAll("'", "''")}'`;
const arr = (xs: string[]) => `array[${xs.map(q).join(", ")}]::text[]`;

const out: string[] = ["-- Generated by scripts/generate-seed.mts — do not edit by hand.", ""];

out.push("insert into public.card_rarities (id, tier, name, color, weight, effect) values");
out.push(
  Object.values(RARITIES)
    .map((r) => `  (${q(r.id)}, ${r.tier}, ${q(r.name)}, ${q(r.color)}, ${r.weight}, ${q(r.effect)})`)
    .join(",\n") +
    "\non conflict (id) do update set tier = excluded.tier, name = excluded.name, color = excluded.color, weight = excluded.weight, effect = excluded.effect;",
);
out.push("");

out.push(
  "insert into public.challenges (id, title, description, instructions, category, rarity_id, difficulty, points, estimated_minutes, evidence_type, available, tags, created_at) values",
);
out.push(
  CHALLENGES.map(
    (c) =>
      `  (${q(c.id)}, ${q(c.title)}, ${q(c.description)}, ${arr(c.instructions)}, ${q(c.category)}, ${q(c.rarity)}, ${q(c.difficulty)}, ${c.points}, ${c.estimatedMinutes}, ${q(c.evidence)}, ${c.available}, ${arr(c.tags)}, ${q(c.createdAt)})`,
  ).join(",\n") +
    "\non conflict (id) do update set title = excluded.title, description = excluded.description, instructions = excluded.instructions, category = excluded.category, rarity_id = excluded.rarity_id, difficulty = excluded.difficulty, points = excluded.points, estimated_minutes = excluded.estimated_minutes, evidence_type = excluded.evidence_type, available = excluded.available, tags = excluded.tags;",
);
out.push("");

out.push("insert into public.achievements (id, name, description, icon, reward_points) values");
out.push(
  ACHIEVEMENTS.map(
    (a) => `  (${q(a.id)}, ${q(a.name)}, ${q(a.description)}, ${q(a.icon)}, ${a.reward.kind === "points" ? a.reward.amount : 0})`,
  ).join(",\n") +
    "\non conflict (id) do update set name = excluded.name, description = excluded.description, icon = excluded.icon, reward_points = excluded.reward_points;",
);

console.log(out.join("\n"));
